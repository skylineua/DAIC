{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "ignoreDeprecations": "6.0", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": "src", "sourceMap": true,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
